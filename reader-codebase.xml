AWSTemplateFormatVersion: "2010-09-09"
Description: Reader production data stores, secrets, and private discovery

Parameters:
  JwtSecretValue:
    Type: String
    NoEcho: true
  OpenAiApiKeySecretValue:
    Type: String
    NoEcho: true
  LangfuseSecretKeyValue:
    Type: String
    NoEcho: true
    Default: ""
  GoogleClientSecretValue:
    Type: String
    NoEcho: true
  ChromaServerAuthnCredentialsSecretValue:
    Type: String
    NoEcho: true
  ChromaClientAuthCredentialsSecretValue:
    Type: String
    NoEcho: true
  DatabaseDeletionProtection:
    Type: String
    AllowedValues:
      - "true"
      - "false"
  VpcId:
    Type: AWS::EC2::VPC::Id
  PrivateSubnetIds:
    Type: List<AWS::EC2::Subnet::Id>
  RdsSecurityGroupId:
    Type: AWS::EC2::SecurityGroup::Id
  RedisSecurityGroupId:
    Type: AWS::EC2::SecurityGroup::Id
  EfsSecurityGroupId:
    Type: AWS::EC2::SecurityGroup::Id

Conditions:
  HasLangfuseSecretKey: !Not [!Equals [!Ref LangfuseSecretKeyValue, ""]]

Resources:
  DbCredentialsSecret:
    Type: AWS::SecretsManager::Secret
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/DB_CREDENTIALS
      GenerateSecretString:
        SecretStringTemplate: '{"username":"postgres"}'
        GenerateStringKey: password
        PasswordLength: 32
        ExcludePunctuation: true
      Tags:
        - Key: project
          Value: reader

  DatabaseUrlSecret:
    Type: AWS::SecretsManager::Secret
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/DATABASE_URL
      SecretString: !Sub postgresql://postgres:{{resolve:secretsmanager:${DbCredentialsSecret}:SecretString:password}}@${PostgresInstance.Endpoint.Address}:${PostgresInstance.Endpoint.Port}/reader
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader/prod/DATABASE_URL

  RedisUrlSecret:
    Type: AWS::SecretsManager::Secret
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/REDIS_URL
      SecretString: !Sub redis://${RedisCluster.PrimaryEndPoint.Address}:${RedisCluster.PrimaryEndPoint.Port}
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader/prod/REDIS_URL

  JwtSecret:
    Type: AWS::SecretsManager::Secret
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/JWT_SECRET
      SecretString: !Ref JwtSecretValue
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader/prod/JWT_SECRET

  OpenAiApiKeySecret:
    Type: AWS::SecretsManager::Secret
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/OPENAI_API_KEY
      SecretString: !Ref OpenAiApiKeySecretValue
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader/prod/OPENAI_API_KEY

  LangfuseSecretKeySecret:
    Type: AWS::SecretsManager::Secret
    Condition: HasLangfuseSecretKey
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/LANGFUSE_SECRET_KEY
      SecretString: !Ref LangfuseSecretKeyValue
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader/prod/LANGFUSE_SECRET_KEY

  ChromaServerAuthnCredentialsSecret:
    Type: AWS::SecretsManager::Secret
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/CHROMA_SERVER_AUTHN_CREDENTIALS
      SecretString: !Ref ChromaServerAuthnCredentialsSecretValue
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader/prod/CHROMA_SERVER_AUTHN_CREDENTIALS

  ChromaClientAuthCredentialsSecret:
    Type: AWS::SecretsManager::Secret
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/CHROMA_CLIENT_AUTH_CREDENTIALS
      SecretString: !Ref ChromaClientAuthCredentialsSecretValue
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader/prod/CHROMA_CLIENT_AUTH_CREDENTIALS

  GoogleClientSecretSecret:
    Type: AWS::SecretsManager::Secret
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Name: reader/prod/GOOGLE_CLIENT_SECRET
      SecretString: !Ref GoogleClientSecretValue
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader/prod/GOOGLE_CLIENT_SECRET

  UploadsBucket:
    Type: AWS::S3::Bucket
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      BucketName: !Sub reader-prod-${AWS::AccountId}-${AWS::Region}
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - BucketKeyEnabled: true
            ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: !Sub reader-prod-${AWS::AccountId}-${AWS::Region}

  RdsSubnetGroup:
    Type: AWS::RDS::DBSubnetGroup
    Properties:
      DBSubnetGroupName: reader-prod-postgres-subnets
      DBSubnetGroupDescription: Reader prod private RDS subnet group
      SubnetIds:
        - !Select [1, !Ref PrivateSubnetIds]
        - !Select [0, !Ref PrivateSubnetIds]
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader-prod-postgres-subnets

  PostgresInstance:
    Type: AWS::RDS::DBInstance
    DeletionPolicy: Snapshot
    UpdateReplacePolicy: Snapshot
    Properties:
      DBInstanceIdentifier: reader-prod-postgres
      Engine: postgres
      EngineVersion: "18.3"
      DBInstanceClass: db.t4g.micro
      DBName: reader
      MasterUsername: postgres
      MasterUserPassword: !Sub "{{resolve:secretsmanager:${DbCredentialsSecret}:SecretString:password}}"
      AllocatedStorage: 20
      StorageType: gp3
      StorageEncrypted: true
      MultiAZ: false
      PubliclyAccessible: false
      DeletionProtection: !Ref DatabaseDeletionProtection
      BackupRetentionPeriod: 1
      PreferredBackupWindow: 08:46-09:16
      PreferredMaintenanceWindow: tue:03:09-tue:03:39
      CACertificateIdentifier: rds-ca-rsa2048-g1
      VPCSecurityGroups:
        - !Ref RdsSecurityGroupId
      DBSubnetGroupName: !Ref RdsSubnetGroup
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader-prod-postgres

  RedisSubnetGroup:
    Type: AWS::ElastiCache::SubnetGroup
    Properties:
      CacheSubnetGroupName: reader-prod-redis-subnets
      Description: Reader prod Redis private subnets
      SubnetIds:
        - !Select [0, !Ref PrivateSubnetIds]
        - !Select [1, !Ref PrivateSubnetIds]
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader-prod-redis-subnets

  RedisCluster:
    Type: AWS::ElastiCache::ReplicationGroup
    Properties:
      ReplicationGroupId: reader-prod-redis
      ReplicationGroupDescription: Reader production Redis
      Engine: redis
      EngineVersion: "7.1"
      CacheNodeType: cache.t4g.micro
      NumCacheClusters: 1
      AutomaticFailoverEnabled: false
      SecurityGroupIds:
        - !Ref RedisSecurityGroupId
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      TransitEncryptionEnabled: false
      AtRestEncryptionEnabled: true
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader-prod-redis

  ChromaFileSystem:
    Type: AWS::EFS::FileSystem
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      Encrypted: true
      PerformanceMode: generalPurpose
      ThroughputMode: elastic
      FileSystemTags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader-prod-chroma-efs

  ChromaMountTargetA:
    Type: AWS::EFS::MountTarget
    Properties:
      FileSystemId: !Ref ChromaFileSystem
      SubnetId: !Select [0, !Ref PrivateSubnetIds]
      SecurityGroups:
        - !Ref EfsSecurityGroupId

  ChromaMountTargetB:
    Type: AWS::EFS::MountTarget
    Properties:
      FileSystemId: !Ref ChromaFileSystem
      SubnetId: !Select [1, !Ref PrivateSubnetIds]
      SecurityGroups:
        - !Ref EfsSecurityGroupId

  PrivateDnsNamespace:
    Type: AWS::ServiceDiscovery::PrivateDnsNamespace
    Properties:
      Name: reader-prod.local
      Vpc: !Ref VpcId
      Properties:
        DnsProperties:
          SOA:
            TTL: 15
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: reader-prod.local

  ChromaDiscoveryService:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: chroma
      NamespaceId: !Ref PrivateDnsNamespace
      DnsConfig:
        RoutingPolicy: MULTIVALUE
        DnsRecords:
          - Type: A
            TTL: 15
      HealthCheckCustomConfig:
        FailureThreshold: 1
      Tags:
        - Key: project
          Value: reader
        - Key: Name
          Value: chroma.reader-prod.local

Outputs:
  UploadsBucketName:
    Value: !Ref UploadsBucket
  UploadsBucketArn:
    Value: !GetAtt UploadsBucket.Arn
  DatabaseUrlSecretArn:
    Value: !Ref DatabaseUrlSecret
  RedisUrlSecretArn:
    Value: !Ref RedisUrlSecret
  JwtSecretArn:
    Value: !Ref JwtSecret
  OpenAiApiKeySecretArn:
    Value: !Ref OpenAiApiKeySecret
  LangfuseSecretKeySecretArn:
    Value: !If [HasLangfuseSecretKey, !Ref LangfuseSecretKeySecret, ""]
  ChromaServerAuthnCredentialsSecretArn:
    Value: !Ref ChromaServerAuthnCredentialsSecret
  ChromaClientAuthCredentialsSecretArn:
    Value: !Ref ChromaClientAuthCredentialsSecret
  GoogleClientSecretSecretArn:
    Value: !Ref GoogleClientSecretSecret
  ChromaFileSystemId:
    Value: !Ref ChromaFileSystem
  ChromaDiscoveryServiceArn:
    Value: !GetAtt ChromaDiscoveryService.Arn
  RdsEndpoint:
    Value: !GetAtt PostgresInstance.Endpoint.Address
  RedisEndpoint:
    Value: !GetAtt RedisCluster.PrimaryEndPoint.Address
</file>


            .returning({ id: Books.id });
        log.info("Book marked as ready", { bookId, collectionName });
        return updated.length === 1;
    },

    async markFailed(bookId, error) {
        log.error("Marking book as failed", { bookId, error });
        await db
            .update(Books)
            .set({
                processingStatus: "failed",
                processingError: error,
            })
            .where(eq(Books.id, bookId));
        log.error("Book marked as failed", { bookId, error });
    },
};

export const handleProcessUploadedBook = async (
    payload: ProcessUploadedBookPayload,
    repository: BookProcessingRepository,
    processBook: ProcessBookForSearch,
    options: ProcessUploadedBookOptions = {}
): Promise<ProcessBookResult> => {
    const start = Date.now();
    log.info("Handling uploaded book processing", {
        bookId: payload.bookId,
        userId: payload.userId,
        fileKey: payload.fileKey,
        fileType: payload.fileType,
        markFailedOnError: options.markFailedOnError ?? true,
    });

    try {
        const book = await repository.findBookForProcessing(
            payload.bookId,
            payload.userId
        );
        if (!book) {
            throw new Error(`Book ${payload.bookId} was not found`);
        }
        if (book.fileType !== payload.fileType) {
            throw new Error(
                `Book ${payload.bookId} file type changed from ${payload.fileType} to ${book.fileType}`
            );
        }

        log.info("Processing book", {
            bookId: payload.bookId,
            fileKey: payload.fileKey,
        });

        const result = await processBook({
            bookId: payload.bookId,
            fileKey: payload.fileKey,
            fileType: payload.fileType,
        });

        const published = await repository.markReady(
            payload.bookId,
            result.collectionName
        );
        if (!published) {
            log.warn("Book disappeared before ingestion could publish", {
                bookId: payload.bookId,
                collectionName: result.collectionName,
            });
            await vectorStore.deleteCollection(result.collectionName);
            await bookSearchChunkStore.deleteCollectionChunks(
                result.collectionName
            );
            throw new Error(
                `Book ${payload.bookId} was deleted during processing`
            );
        }
        const duration = Date.now() - start;
        log.info("Uploaded book processing succeeded", {
            bookId: payload.bookId,
            collectionName: result.collectionName,
            chunkCount: result.chunks,
            reusedCollection: result.reusedCollection,
            durationMs: duration,
        });
        return result;
    } catch (error) {
        const duration = Date.now() - start;
        log.error("Uploaded book processing failed", {
            bookId: payload.bookId,
            fileKey: payload.fileKey,
            durationMs: duration,
            error: getErrorMessage(error),
        });
        if (options.markFailedOnError ?? true) {
            await repository.markFailed(payload.bookId, getErrorMessage(error));
        } else {
            log.warn("Skipping markFailed for book", {
                bookId: payload.bookId,
            });
        }
        throw error;
    }
};

export const processUploadedBook = async (
    payload: ProcessUploadedBookPayload,
    options: ProcessUploadedBookOptions = {}
): Promise<ProcessBookResult> => {
    log.info("Processing uploaded book (worker entry)", {
        bookId: payload.bookId,
        userId: payload.userId,
        fileKey: payload.fileKey,
        fileType: payload.fileType,
    });
    const result = await handleProcessUploadedBook(
        payload,
        bookProcessingRepository,
        (input) =>
            processBookForSearch(input, {
                storage: storageProvider,
                vectorStore,
                searchIndexStore: bookSearchChunkStore,
            }),
        options
    );
    log.info("Clearing hybrid search cache after processing", {
        collectionName: result.collectionName,
    });
    hybridBookSearchService.clearCollectionCache(result.collectionName);
    return result;
};
</file>

<file path="apps/api/src/services/BookSearchChunkStore.ts">
import { eq } from "drizzle-orm";
import type { SearchIndexStore, TextChunk } from "@reader/processing";
import {
    createLogger,
    type BookSearchChunk,
    type BookSearchChunkMetadata,
} from "@reader/providers";
import { db } from "../db";
import { BookSearchChunks } from "../db/schema";

const log = createLogger("BookSearchChunkStore");

export type { BookSearchChunk };

export const createChunkId = (collectionName: string, chunkIndex: number) =>
    `${collectionName}_${chunkIndex}`;

const normalizeChunk = (
    chunk: TextChunk
): { content: string; metadata?: BookSearchChunkMetadata | null } =>
    typeof chunk === "string"
        ? { content: chunk, metadata: null }
        : { content: chunk.content, metadata: chunk.metadata };

export const bookSearchChunkStore: SearchIndexStore & {
    getCollectionChunks(collectionName: string): Promise<BookSearchChunk[]>;
    deleteCollectionChunks(collectionName: string): Promise<void>;
} = {
    async replaceCollectionChunks(collectionName, chunks) {
        log.info("Replacing collection chunks in DB", {
            collectionName,
            chunkCount: chunks.length,
        });
        await db.transaction(async (tx) => {
            await tx
                .delete(BookSearchChunks)
                .where(eq(BookSearchChunks.collectionName, collectionName));
            log.debug("Deleted existing collection chunks", { collectionName });

            if (!chunks.length) return;
            await tx.insert(BookSearchChunks).values(
                chunks.map((chunk, chunkIndex) => {
                    const normalized = normalizeChunk(chunk);
                    return {
                        id: createChunkId(collectionName, chunkIndex),
                        collectionName,
                        chunkIndex,
                        content: normalized.content,
                        metadata: normalized.metadata,
                    };
                })
            );
        });
        log.info("Inserted collection chunks", {
            collectionName,
            chunkCount: chunks.length,
        });
    },

    async getCollectionChunks(collectionName) {
        log.debug("Fetching collection chunks from DB", { collectionName });
        const chunks = await db
            .select()
            .from(BookSearchChunks)
            .where(eq(BookSearchChunks.collectionName, collectionName))
            .orderBy(BookSearchChunks.chunkIndex);
        log.debug("Fetched collection chunks", {
            collectionName,
            chunkCount: chunks.length,
        });
        return chunks;
    },

    async deleteCollectionChunks(collectionName) {
        log.info("Deleting collection chunks from DB", { collectionName });
        await db
            .delete(BookSearchChunks)
            .where(eq(BookSearchChunks.collectionName, collectionName));
        log.info("Deleted collection chunks from DB", { collectionName });
    },
};
</file>

<file path="apps/api/src/services/ChatServerHistory.ts">
import type { Messages } from "../db/schema";
import type { ChatMessage } from "./OpenAIServices";

export const getSubmittedUserMessage = (body: unknown): string | null => {
    if (!body || typeof body !== "object") return null;

    const { message } = body as { message?: unknown };
    if (typeof message !== "string") return null;

    const content = message.trim();
    return content.length > 0 && content.length <= 8_000 ? content : null;
};

export const buildUserMessageInsert = (
    conversationId: string,
    content: string
) => ({
    conversationId,
    role: "user" as const,
    content,
});

export const toChatHistory = (
    messages: Pick<typeof Messages.$inferSelect, "role" | "content">[]
): ChatMessage[] => {
    const bounded: typeof messages = [];
    let characters = 0;
    for (const message of messages.slice(-30).reverse()) {
        if (characters + message.content.length > 60_000) break;
        bounded.push(message);
        characters += message.content.length;
    }
    return bounded.reverse().map((message) => ({
        role: message.role,
        content: message.content,
    }));
};

export const appendSubmittedUserMessage = (
    history: ChatMessage[],
    content: string
): ChatMessage[] => [...history, { role: "user", content }];
</file>


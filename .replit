modules = ["nodejs-20"]
run = "pnpm run dev"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run start"]
build = ["sh", "-c", "npm run build"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 80

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Run"
author = 10840079
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "production"
mode = "sequential"
author = 10840079

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start"

[[workflows.workflow]]
name = "Dev"
mode = "sequential"
author = 10840079

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

{
    "name": "@reader/application",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "prebuild": "pnpm --filter @reader/domain build",
        "build": "tsc -p tsconfig.json",
        "pretest": "pnpm --filter @reader/domain build",
        "test": "rm -rf ../../.tmp/packages-application-test && tsc -p tsconfig.test.json && NODE_PATH=./node_modules node --test ../../.tmp/packages-application-test/test/*.js"
    },
    "dependencies": {
        "@reader/domain": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "typescript": "^5.7.2"
    }
}

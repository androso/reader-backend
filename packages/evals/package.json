{
    "name": "@reader/evals",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "prebuild": "pnpm --filter @reader/providers build",
        "build": "tsc -p tsconfig.json",
        "pretest": "pnpm --filter @reader/providers build",
        "test": "tsc -p tsconfig.test.json && NODE_PATH=./node_modules:../../packages/providers/node_modules node --test ../../.tmp/packages-evals-test/test/*.js",
        "eval:retrieval": "pnpm build && node dist/cli.js retrieval",
        "eval:answers": "pnpm build && node dist/cli.js answers",
        "eval:langfuse": "pnpm build && node dist/cli.js langfuse",
        "eval:ci": "pnpm build && node dist/cli.js ci"
    },
    "dependencies": {
        "@langfuse/client": "^5.9.0",
        "@reader/providers": "workspace:*",
        "openai": "^4.77.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "typescript": "^5.7.2"
    }
}
